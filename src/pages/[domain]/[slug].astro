---
// Individual entry page at /<domain folder>/<slug>, e.g. /masters/placeholder-teacher.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import SiteShell from '../../layouts/SiteShell.astro';
import EntryHeader from '../../components/EntryHeader.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import Metadata from '../../components/Metadata.astro';
import PersonalNotes from '../../components/PersonalNotes.astro';
import RelatedEntries from '../../components/RelatedEntries.astro';
import { getAllEntries, getEntryDomain, type Entry } from '../../lib/entries';

export const getStaticPaths = (async () => {
  const entries = await getAllEntries();
  return entries.map((entry) => ({
    params: { domain: getEntryDomain(entry).slug, slug: entry.data.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const domain = getEntryDomain(entry);
const hasNotes = Boolean(entry.body?.trim());
---

<SiteShell title={entry.data.title} description={entry.data.description} domain={domain}>
  <article class="entry">
    <EntryHeader entry={entry} />

    <section class="section">
      <MediaPlaceholder media={entry.data.media} />
    </section>

    <Metadata entry={entry} />

    <PersonalNotes empty={!hasNotes}>
      <Content />
    </PersonalNotes>

    <RelatedEntries entry={entry} />
  </article>
</SiteShell>
