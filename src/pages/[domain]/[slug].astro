---
// Individual entry page at /<domain folder>/<slug>, e.g. /masters/placeholder-teacher.
// Domains with their own template (see `domainTemplates`) use it; the rest use the generic layout.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import SiteShell from '../../layouts/SiteShell.astro';
import EntryHeader from '../../components/EntryHeader.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import Metadata from '../../components/Metadata.astro';
import PersonalNotes from '../../components/PersonalNotes.astro';
import Videos from '../../components/Videos.astro';
import Sources from '../../components/Sources.astro';
import RelatedEntries from '../../components/RelatedEntries.astro';
import GymAtlasEntry from '../../components/gym-atlas/GymAtlasEntry.astro';
import { entrySummary, getAllEntries, getEntryDomain, hasNotes, type Entry } from '../../lib/entries';

/** Domain-specific entry templates, keyed by domain slug. */
const domainTemplates: Record<string, typeof GymAtlasEntry> = {
  'gym-atlas': GymAtlasEntry,
};

export const getStaticPaths = (async () => {
  const entries = await getAllEntries();
  return entries.map((entry) => ({
    params: { domain: getEntryDomain(entry).slug, slug: entry.data.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const domain = getEntryDomain(entry);
const Template = domainTemplates[domain.slug];
---

<SiteShell title={entry.data.title} description={entrySummary(entry)} domain={domain}>
  {
    Template ? (
      <Template entry={entry} />
    ) : (
      <article class="entry">
        <EntryHeader entry={entry} />

        <section class="section">
          <MediaPlaceholder photos={entry.data.photos} fallbackAlt={entry.data.title} />
        </section>

        <Metadata entry={entry} />

        <PersonalNotes empty={!hasNotes(entry)}>
          <Content />
        </PersonalNotes>

        <Videos videos={entry.data.videos} />
        <Sources sources={entry.data.sources} />
        <RelatedEntries entry={entry} />
      </article>
    )
  }
</SiteShell>
