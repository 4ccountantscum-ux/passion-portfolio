---
// A compact link card for one entry.
import { getKindLabel } from '../domains';
import { entrySummary, entryUrl, getEntryDomain, type Entry } from '../lib/entries';

interface Props {
  entry: Entry;
  /** Show which domain the entry belongs to (useful in cross-domain lists). */
  showDomain?: boolean;
}

const { entry, showDomain = false } = Astro.props;
const domain = getEntryDomain(entry);
const kindLabel = getKindLabel(domain, entry.data.kind);
const summary = entrySummary(entry);
const eyebrow = [showDomain ? domain.name : null, kindLabel].filter(Boolean).join(' · ');
---

<a class="card entry-card" href={entryUrl(entry)}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h3>{entry.data.title}</h3>
  {summary && <p>{summary}</p>}
</a>
