---
// Where an entry's information came from. Hidden when there are none.

interface Props {
  sources: { title: string; url?: string; note?: string }[];
  heading?: string;
}

const { sources, heading = 'Sources' } = Astro.props;
---

{
  sources.length > 0 && (
    <section class="section sources" aria-labelledby="sources-heading">
      <h2 id="sources-heading">{heading}</h2>
      <ul>
        {sources.map((source) => (
          <li>
            {source.url ? (
              <a href={source.url} rel="noopener">
                {source.title}
              </a>
            ) : (
              source.title
            )}
            {source.note && <span class="muted"> · {source.note}</span>}
          </li>
        ))}
      </ul>
    </section>
  )
}
