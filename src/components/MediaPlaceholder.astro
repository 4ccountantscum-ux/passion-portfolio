---
// Shows an entry's photos (resized automatically), or a labelled empty box when there are none.
// Also used on its own (with a `label`) to reserve space for future visuals like a map.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo {
  src: ImageMetadata;
  alt?: string;
  caption?: string;
}

interface Props {
  photos?: Photo[];
  /** Used as alt text when a photo has neither alt nor caption. */
  fallbackAlt?: string;
  /** Text shown inside the empty box. */
  label?: string;
}

const { photos = [], fallbackAlt = '', label = 'No photos yet' } = Astro.props;
---

{
  photos.length > 0 ? (
    <div class="media-grid">
      {photos.map((photo) => (
        <figure>
          <Image
            src={photo.src}
            alt={photo.alt ?? photo.caption ?? fallbackAlt}
            widths={[400, 800, 1200]}
            sizes="(max-width: 640px) 100vw, 400px"
          />
          {photo.caption && <figcaption>{photo.caption}</figcaption>}
        </figure>
      ))}
    </div>
  ) : (
    <div class="media-empty" role="img" aria-label={label}>
      <span>{label}</span>
    </div>
  )
}
